{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://authzbench-saas.local/schemas/saas-product-security-review.schema.json",
  "title": "SaaS product-security realism review form",
  "type": "object",
  "required": [
    "reviewer_role",
    "review_date",
    "reviewed_commit_sha",
    "app_id",
    "vulnerability_family",
    "auth_model_fidelity",
    "control_realism",
    "scoring_validity",
    "coverage_adequacy",
    "synthetic_gap_severity",
    "blocking_issue",
    "comments_public_safe"
  ],
  "properties": {
    "reviewer_role": {
      "type": "string",
      "enum": [
        "SaaS product-security reviewer"
      ]
    },
    "review_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "reviewed_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "app_id": {
      "type": "string",
      "enum": [
        "project_mgmt",
        "billing",
        "support",
        "file_sharing",
        "api_tokens",
        "audit_settings"
      ]
    },
    "vulnerability_family": {
      "type": "string",
      "enum": [
        "bola",
        "bfla",
        "cross-tenant",
        "role-bypass",
        "token-scope",
        "entitlement",
        "share-link",
        "reassignment",
        "admin-exposure"
      ]
    },
    "auth_model_fidelity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "control_realism": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "scoring_validity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "coverage_adequacy": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "synthetic_gap_severity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "blocking_issue": {
      "type": "boolean"
    },
    "comments_public_safe": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
