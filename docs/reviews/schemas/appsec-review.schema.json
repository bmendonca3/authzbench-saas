{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://authzbench-saas.local/schemas/appsec-review.schema.json",
  "title": "AppSec external review form",
  "description": "Per-task AppSec review form used by the AppSec review lane.",
  "type": "object",
  "required": [
    "reviewer_role",
    "review_date",
    "reviewed_commit_sha",
    "pack_id",
    "task_id",
    "realistic",
    "oracle_clear",
    "boundary_valid",
    "false_positive_control_meaningful",
    "unsafe_ambiguity",
    "difficulty_estimate",
    "comments_public_safe"
  ],
  "properties": {
    "reviewer_role": {"type": "string", "enum": ["AppSec reviewer"]},
    "review_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "reviewed_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pack_id": {
      "type": "string",
      "enum": [
        "public",
        "active-private-holdout-v1-pack",
        "shadow-private-holdout-v1-pack"
      ]
    },
    "task_id": {"type": "string", "minLength": 1},
    "realistic": {"type": "integer", "minimum": 1, "maximum": 5},
    "oracle_clear": {"type": "integer", "minimum": 1, "maximum": 5},
    "boundary_valid": {"type": "integer", "minimum": 1, "maximum": 5},
    "false_positive_control_meaningful": {"type": "integer", "minimum": 1, "maximum": 5},
    "unsafe_ambiguity": {"type": "integer", "minimum": 0, "maximum": 5, "description": "Inverted: 5 means unambiguously safe."},
    "difficulty_estimate": {
      "type": "string",
      "enum": [
        "single-step-obvious",
        "single-step-with-decoy",
        "multi-step-discovery",
        "state-changing",
        "token-scope-reasoning",
        "false-positive-trap-heavy"
      ]
    },
    "cwe_or_owasp_mapping": {"type": "string"},
    "comments_public_safe": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
