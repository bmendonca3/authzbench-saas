{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://authzbench-saas.local/schemas/agent-tooling-review.schema.json",
  "title": "Agent / tooling review form",
  "type": "object",
  "required": [
    "reviewer_role",
    "review_date",
    "reviewed_commit_sha",
    "harness_contract_clear",
    "tool_access_requirements_enforceable",
    "transcript_schema_replayable",
    "target_request_correlation_enforced",
    "submission_bundle_validator_acceptable",
    "harbor_status_table_consistent",
    "tool_agent_comparability_keys_acceptable",
    "blocking_issues",
    "nonblocking_issues",
    "comments_public_safe"
  ],
  "properties": {
    "reviewer_role": {
      "type": "string",
      "enum": [
        "AI-agent / tooling reviewer"
      ]
    },
    "review_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "reviewed_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "harness_contract_clear": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "tool_access_requirements_enforceable": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "transcript_schema_replayable": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "target_request_correlation_enforced": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "submission_bundle_validator_acceptable": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "harbor_status_table_consistent": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "tool_agent_comparability_keys_acceptable": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "blocking_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nonblocking_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "comments_public_safe": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}