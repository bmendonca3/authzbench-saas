{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://authzbench-saas.local/schemas/evals-review.schema.json",
  "title": "Benchmark / evals methodology review form",
  "type": "object",
  "required": [
    "reviewer_role",
    "review_date",
    "reviewed_commit_sha",
    "split_design_acceptable",
    "scoring_semantics_clear",
    "determinism_contract_holds",
    "variance_framing_acceptable",
    "stale_current_separation_clear",
    "leaderboard_tiers_acceptable",
    "anti_gaming_policy_acceptable",
    "claim_boundary_enforcement_acceptable",
    "blocking_issues",
    "nonblocking_issues",
    "comments_public_safe"
  ],
  "properties": {
    "reviewer_role": {
      "type": "string",
      "enum": [
        "Benchmark / evals reviewer"
      ]
    },
    "review_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "reviewed_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "split_design_acceptable": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "scoring_semantics_clear": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "determinism_contract_holds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "variance_framing_acceptable": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "stale_current_separation_clear": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "leaderboard_tiers_acceptable": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "anti_gaming_policy_acceptable": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "claim_boundary_enforcement_acceptable": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "blocking_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nonblocking_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "comments_public_safe": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}