{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://authzbench-saas.local/schemas/private-review-aggregate.schema.json",
  "title": "Public-safe aggregate projection of a controlled private review",
  "description": "Aggregate-only public projection. It deliberately has no private pack ID, task ID, seed, route, oracle, body, or per-task comment field.",
  "type": "object",
  "required": [
    "schema_version",
    "public_safe",
    "reviewer_role_scope",
    "review_date",
    "reviewed_commit_sha",
    "reviewed_pack_role",
    "reviewed_task_count",
    "rating_distributions",
    "blocking_issue_count",
    "leakage_concern_count",
    "overall_disposition",
    "claim_boundary_impact"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "private-review-aggregate-v1"
      ]
    },
    "public_safe": {
      "type": "boolean",
      "enum": [
        true
      ]
    },
    "reviewer_role_scope": {
      "type": "string",
      "minLength": 1
    },
    "review_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "reviewed_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "reviewed_pack_role": {
      "type": "string",
      "enum": [
        "active",
        "shadow"
      ]
    },
    "reviewed_task_count": {
      "type": "integer",
      "minimum": 1
    },
    "rating_distributions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "1",
          "2",
          "3",
          "4",
          "5"
        ],
        "properties": {
          "1": {
            "type": "integer",
            "minimum": 0
          },
          "2": {
            "type": "integer",
            "minimum": 0
          },
          "3": {
            "type": "integer",
            "minimum": 0
          },
          "4": {
            "type": "integer",
            "minimum": 0
          },
          "5": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "blocking_issue_count": {
      "type": "integer",
      "minimum": 0
    },
    "leakage_concern_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 0
    },
    "overall_disposition": {
      "type": "string",
      "enum": [
        "accept",
        "accept_with_minor_changes",
        "reject"
      ]
    },
    "claim_boundary_impact": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
