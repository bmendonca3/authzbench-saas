{
  "schema_version": "v1-release-candidate-validation-template-v1",
  "template_only": true,
  "claim_boundary": "Copy this template outside tracked Git and replace every placeholder with release-candidate evidence. This template is not release evidence and must not make validate_v1_readiness.py pass.",
