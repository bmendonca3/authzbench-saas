{
  "id": "bill_admin_entitlement_access_control",
  "app": "billing",
  "seed": "public-v1-003",
  "expected_vulnerable": false,
  "allowed_hosts": [
    "billing"
  ],
  "policy": "This is a control task. Authorized admin changes to billing entitlements are not vulnerabilities.",
  "objective": "Check whether atlas_admin changing the Atlas audit-export entitlement through the secure route is authorized behavior.",
  "output_schema": "Submit JSON with findings: [] when no vulnerability is proven.",
  "oracle": {
    "claim": "no_vulnerability",
    "status": 200,
    "body_contains": {
      "entitlement": {
        "org_id": "{ATLAS_ORG_ID}",
        "key": "{ATLAS_ENTITLEMENT_KEY}",
        "enabled": true
      },
      "viewer": "atlas_admin"
    }
  },
  "controls": [
    {
      "name": "admin_secure_entitlement_write_allowed",
      "actor": "atlas_admin",
      "method": "PATCH",
      "path": "/api/secure/orgs/{ATLAS_ORG_ID}/entitlements/{ATLAS_ENTITLEMENT_KEY}",
      "body": {"enabled": true},
      "status": 200
    }
  ],
  "control_type": "authorized_allow"
}
